<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MitosScope.App.ViewModels"
             xmlns:panels="using:MitosScope.App.ViewModels.Panels"
             x:Class="MitosScope.App.Views.Panels.StatusPanelView"
             x:DataType="panels:StatusPanelViewModel">
    <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="MitosScope" />

        <TextBlock Classes="error"
                   Text="{Binding Tracker.StartupError}"
                   IsVisible="{Binding Tracker.StartupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="muted"
                   Text="{Binding Tracker.SearchingText}"
                   IsVisible="{Binding !Tracker.Sessions.Count}" />

        <!-- One row per logged-in client; click (in edit mode) to choose which one the panels show. -->
        <ItemsControl ItemsSource="{Binding Tracker.Sessions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionViewModel">
                    <Button Background="Transparent" Padding="0,2" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((panels:StatusPanelViewModel)DataContext).Tracker.SelectCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <Run Text="{Binding SlotText}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DisplayName}" />
                            </TextBlock>
                            <TextBlock Classes="muted" Text="{Binding StatusText}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Game processes with no API: not logged in yet, or the client's API went down. -->
        <StackPanel Spacing="2" IsVisible="{Binding Tracker.HasInstancesWithoutApi}">
            <ItemsControl ItemsSource="{Binding Tracker.InstancesWithoutApi}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFFFB060">
                            <Run Text="Instance without API (PID " /><Run Text="{Binding}" /><Run Text=")" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" Text="Log in. If already logged in, restart that instance." />
        </StackPanel>

        <!-- Item icons download (new items pack from the game) -->
        <StackPanel Spacing="3" IsVisible="{Binding Tracker.IsUpdatingItems}">
            <TextBlock Classes="muted" Text="{Binding Tracker.ItemsUpdateText}" TextTrimming="CharacterEllipsis" />
            <ProgressBar Minimum="0" Maximum="100" MinWidth="0" Height="4"
                         Value="{Binding Tracker.ItemsUpdatePercent}"
                         IsIndeterminate="{Binding Tracker.ItemsUpdateIndeterminate}" />
        </StackPanel>

        <TextBlock Classes="muted" IsVisible="{Binding IsEditMode}"
                   Text="Edit mode: drag/resize the panels. Ctrl+Shift+E to lock." />
    </StackPanel>
</UserControl>
